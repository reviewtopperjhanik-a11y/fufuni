{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "entryPoints": [
    "apps/client/src/main.tsx",
    "apps/merchant/src/index.ts"
  ],
  "tsconfig": "tsconfig.json",
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/api",
  "router": "module",
  "cleanOutputDir": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "readme": "none"
}
