{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:env": "bash -c 'set -a && source ../../.env && set +a; base=\"\"; for arg in \"$@\"; do case \"$arg\" in --base=*) base=\"${arg#*=}\";; esac; done; if [ -n \"$base\" ]; then export STORE_URL=\"http://localhost:5173${base}\"; export CORS_ORIGIN=\"http://localhost:5173${base}\"; fi; exec vite \"$@\"' --",
    "build": "tsc && vite build",
    "build:env": "bash -c 'set -a && source ../../.env && set +a && tsc && vite build \"$@\"' --",
    "lint": "eslint ./src/**/**/*.{ts,tsx} --fix",
    "type-check": "tsc --noEmit",
    "preview:env": "bash -c 'set -a && source ../../.env && set +a && vite preview \"$@\"' --",
    "stripe:listen": "true",
    "clean": "rm -rf dist .turbo node_modules/.vite node_modules/.cache",
    "update:heroui:cli": "npx heroui-cli@latest upgrade --all",
    "update:heroui": "node --no-warnings --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' ./update-heroui.ts",
    "openapi": "node --experimental-strip-types get-openapi.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.16.2",
    "@heroui/react": "^3.0.4",
    "@heroui/styles": "^3.0.4",
    "@react-aria/visually-hidden": "3.9.0",
    "@react-types/shared": "^3.34.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "clsx": "^2.1.1",
    "i18next": "^26.1.0",
    "i18next-http-backend": "^4.0.0",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "oidc-client-ts": "^3.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.15.0",
    "swagger-ui-react": "^5.32.6",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@sctg/vite-plugin-github-pages-spa": "^0.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-jsdoc": "^6",
    "@types/swagger-ui-react": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-perfectionist": "^5.9.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "swagger-jsdoc": "^6.2.8",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
